# ── Secrets & real user data ───────────────────────────────────────────────────
# Never commit these: data.json holds account passwords and TOTP secrets in
# plain text, and the .pem files are the TLS private keys for this machine.
# Copy data.example.json -> data.json to get started.
data.json
dist/data.json

# TLS material. The committed certificates are per-machine and contain a
# private key, so they are ignored too; start_https.py regenerates them.
*.pem
.cert_trusted

# ── User-uploaded content ──────────────────────────────────────────────────────
uploads/
receipts/
profile_pics/
store_images/

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ── Build output ───────────────────────────────────────────────────────────────
build/
dist/
*.manifest

# ── Test artefacts ─────────────────────────────────────────────────────────────
# Regenerated by tests/verify-ui.js
shots/

# ── Editors & OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
.claude/
Thumbs.db
desktop.ini
*.swp
